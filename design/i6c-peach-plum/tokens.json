{
  "name": "ScreenTime · Peach & plum (I6c)",
  "font": {
    "family": "Rubik",
    "weights": [
      400,
      500,
      600
    ],
    "googleFonts": "https://fonts.googleapis.com/css2?family=Rubik:wght@400;500;600;700&display=swap",
    "note": "One family for Latin and Hebrew. No separate Hebrew face, no serif."
  },
  "color": {
    "ground": "#FFF6EE",
    "ink": "#2A1E2E",
    "muted": "#6E5F66",
    "hairline": "#F0E3D8",
    "tint": "#FFEDE0",
    "surface": "#FFFFFF",
    "peach": "#FFB088",
    "rose": "#F79AC0",
    "ok": "#12A87A",
    "over": "#B3261E",
    "navInactive": "#B9A9B5",
    "okContainer": "#DFF6EC",
    "okText": "#0F6B4E",
    "overContainer": "#FBE2DF",
    "tv": {
      "ground": "#1E1622",
      "ink": "#FFF6EE",
      "muted": "#B9A9B5",
      "surface": "rgba(255,255,255,0.08)",
      "line": "rgba(255,255,255,0.16)",
      "okText": "#9FE9CE",
      "errorContainer": "rgba(179,38,30,0.22)",
      "errorLine": "#D9534F",
      "errorText": "#FFD3CD"
    },
    "glow": {
      "peach": "rgba(255,176,136,0.24)",
      "rose": "rgba(247,154,192,0.20)",
      "tvPeach": "rgba(255,176,136,0.16)",
      "tvRose": "rgba(247,154,192,0.14)"
    },
    "roles": {
      "primaryAction": "ink",
      "primaryActionText": "surface",
      "accentFill": "peach",
      "accentFillText": "ink",
      "arcGradient": [
        "peach",
        "rose"
      ],
      "focusRingTv": "peach",
      "liveDot": "ok",
      "timesUp": "over"
    }
  },
  "type": {
    "phone": {
      "gauge": {
        "size": 56,
        "weight": 600,
        "letterSpacing": "-0.03em"
      },
      "gaugeWord": {
        "size": 16,
        "weight": 500
      },
      "title": {
        "size": 30,
        "weight": 600,
        "letterSpacing": "-0.03em"
      },
      "heading": {
        "size": 18,
        "weight": 600,
        "letterSpacing": "-0.01em"
      },
      "bodyStrong": {
        "size": 16,
        "weight": 600
      },
      "body": {
        "size": 15,
        "weight": 500
      },
      "label": {
        "size": 14,
        "weight": 600
      },
      "caption": {
        "size": 13,
        "weight": 500
      },
      "nav": {
        "size": 13,
        "weight": 600
      },
      "sheetTitle": {
        "size": 24,
        "weight": 600,
        "letterSpacing": "-0.02em"
      },
      "codeTile": {
        "size": 40,
        "weight": 600
      }
    },
    "tv": {
      "headline": {
        "size": 120,
        "weight": 600,
        "lineHeight": 1.02,
        "letterSpacing": "-0.03em",
        "note": "Block screen 140, Ask 132, Keypad 88; Hebrew max 120"
      },
      "body": {
        "size": 36,
        "weight": 400,
        "lineHeight": 1.4
      },
      "button": {
        "size": 32,
        "weight": 600
      },
      "label": {
        "size": 28,
        "weight": 600
      },
      "footer": {
        "size": 26,
        "weight": 500
      },
      "codeTile": {
        "size": 84,
        "weight": 600
      },
      "keypadKey": {
        "size": 56,
        "weight": 600
      },
      "countdown": {
        "size": 140,
        "weight": 600
      },
      "minimum": 24
    },
    "web": {
      "title": {
        "size": 34,
        "weight": 600,
        "letterSpacing": "-0.03em"
      },
      "sectionLabel": {
        "size": 15,
        "weight": 600
      }
    }
  },
  "spacing": {
    "scale": [
      4,
      8,
      12,
      16,
      22,
      26,
      36
    ],
    "phoneGutter": 22,
    "cardPadding": 24,
    "phoneTopInset": 56,
    "webGutter": 40
  },
  "radius": {
    "dot": 3,
    "iconTile": 12,
    "tile": 14,
    "input": 18,
    "strip": 20,
    "card": 22,
    "sheet": 28,
    "pill": 999
  },
  "shadow": {
    "card": "0 1px 2px rgba(42,30,46,0.04), 0 10px 30px rgba(42,30,46,0.06)",
    "pillLight": "0 1px 2px rgba(42,30,46,0.05), 0 6px 18px rgba(42,30,46,0.07)",
    "navPill": "0 14px 32px rgba(42,30,46,0.25)",
    "sheet": "0 -12px 40px rgba(42,30,46,0.22)"
  },
  "sizes": {
    "touchTargetMin": 44,
    "navPillHeight": 58,
    "navItemHeight": 46,
    "modeTile": {
      "height": 84,
      "radius": 22
    },
    "requestStrip": {
      "minHeight": 68,
      "radius": 20
    },
    "arc": {
      "width": 300,
      "height": 170,
      "radius": 120,
      "stroke": 16,
      "cx": 150,
      "cy": 150
    },
    "tvButton": {
      "height": 92,
      "paddingX": 56,
      "ghostBorder": 3
    },
    "tvCodeTile": {
      "w": 118,
      "h": 148,
      "radius": 24
    },
    "tvKey": {
      "size": 150,
      "radius": 26,
      "gap": 22
    },
    "webRail": {
      "width": 96
    }
  },
  "motion": {
    "livePulse": {
      "keyframes": "box-shadow 0 0 0 0 rgba(18,168,122,.45) → 0 0 0 8px transparent",
      "duration": "2s",
      "easing": "ease-out",
      "loop": true
    },
    "waitPulse": {
      "keyframes": "scale 1 → 1.12 → 1, opacity .7 → 1 → .7",
      "duration": "1.8s",
      "easing": "ease-in-out",
      "loop": true
    },
    "tvFocus": {
      "ring": "0 0 0 6px <tv.ground>, 0 0 0 12px <peach>",
      "scale": 1.04,
      "duration": "150ms"
    },
    "arcFill": {
      "note": "animate stroke-dashoffset on load, 600ms ease-out"
    }
  },
  "rtl": {
    "mirror": [
      "layout (flex/grid direction)",
      "arc fill direction (scale(-1,1) around the arc centre)",
      "chevrons",
      "web side rail",
      "sheet handle stays centred"
    ],
    "neverMirror": [
      "digits and h:mm times",
      "unlock code tiles",
      "pairing code tiles",
      "TV keypad grid",
      "app names (YouTube, Netflix)"
    ],
    "fontNote": "Rubik covers Hebrew; keep one family. Gauge shows only h:mm plus one word ≤6 chars — long phrases go in the caption under the arc."
  }
}