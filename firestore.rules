rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helpers -----------------------------------------------------------
    // These operate on a family document's *data* (the stored/server state),
    // never on client-supplied request.resource.data, so membership and role
    // can't be forged by the write itself.

    function signedIn() {
      return request.auth != null;
    }

    // Parents sign in with Google; only the TV signs in anonymously.
    function isParentAccount() {
      return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // The family doc, fetched from server state, for rules that live outside
    // the /families/{familyId} match (subcollections, /devices).
    function familyDoc(familyId) {
      return get(/databases/$(database)/documents/families/$(familyId)).data;
    }

    function isMemberOf(fam) {
      return signedIn() && (request.auth.uid in fam.roles);
    }

    function isAdminOf(fam) {
      return isMemberOf(fam) && fam.roles[request.auth.uid] == 'admin';
    }

    // The single "main admin" — the only account allowed to control the TV.
    function isOwnerOf(fam) {
      return signedIn() && request.auth.uid == fam.ownerUid;
    }

    // Paired TV devices authenticate anonymously; their uid is the deviceId.
    function isDeviceOf(fam) {
      return signedIn() && (request.auth.uid in fam.get('devices', []));
    }

    // Parents (admin or user) and paired TVs may read family data.
    function canReadOf(fam) {
      return isMemberOf(fam) || isDeviceOf(fam);
    }

    // ---- Schema helpers ----------------------------------------------------
    // Every write is checked against the fields it may touch and their types.
    // Wrong-typed data used to crash the TV's parser and switch enforcement
    // off; unbounded fields let any writer bloat a doc.
    //
    // Updates are checked on the keys they CHANGE, not on the whole doc, so
    // older docs carrying a retired field (e.g. fcmTokens) stay writable.

    function touchesOnly(keys) {
      return resource == null
        ? request.resource.data.keys().hasOnly(keys)
        : request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function optInt(k, lo, hi) {
      let d = request.resource.data;
      return !(k in d) || (d[k] is int && d[k] >= lo && d[k] <= hi);
    }

    function optBool(k) {
      let d = request.resource.data;
      return !(k in d) || d[k] is bool;
    }

    function optString(k, maxLen) {
      let d = request.resource.data;
      return !(k in d) || (d[k] is string && d[k].size() <= maxLen);
    }

    function optNullableDate(k) {
      let d = request.resource.data;
      return !(k in d) || d[k] == null || (d[k] is string && d[k].matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
    }

    function optTimestamp(k) {
      let d = request.resource.data;
      return !(k in d) || d[k] is timestamp;
    }

    function isPackageName(s) {
      return s is string && s.matches('^[A-Za-z0-9_.]{1,255}$');
    }

    // ---- /users/{uid} ------------------------------------------------------
    // Each signed-in user owns their own doc, which points at their familyId.
    // Other members of that same family may also read it (display name only,
    // shown next to them in the family/member list) — mirrors how paired TV
    // device docs are readable by every family member.
    match /users/{uid} {
      allow get, list: if signedIn() && (
        request.auth.uid == uid
        || (resource.data.familyId is string && isMemberOf(familyDoc(resource.data.familyId)))
      );
      allow create, update: if signedIn() && request.auth.uid == uid
        && touchesOnly(['displayName', 'familyId', 'language'])
        && (!('displayName' in request.resource.data)
            || request.resource.data.displayName == null
            || (request.resource.data.displayName is string && request.resource.data.displayName.size() <= 100))
        && (!('language' in request.resource.data)
            || (request.resource.data.language is string && request.resource.data.language.matches('^[a-z]{2,3}$')))
        && familyIdChangeAllowed(uid);
      allow delete: if signedIn() && request.auth.uid == uid;

      // A user may only point their doc at a family they are actually in.
      // getAfter() so createFamily's batch (family + user doc together) passes.
      // Joining an existing family is done server-side by joinFamilyWithInvite.
      function familyIdChangeAllowed(uid) {
        let d = request.resource.data;
        return !('familyId' in d)
          || (resource != null && resource.data.get('familyId', null) == d.familyId)
          || (d.familyId is string
              && uid in getAfter(/databases/$(database)/documents/families/$(d.familyId)).data.roles);
      }

      // Per-user private data (FCM push tokens). Unlike the user doc above,
      // NOT readable by other family members or the TV — only the user
      // themselves and the Cloud Functions (admin SDK).
      match /private/{doc} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    // ---- /families/{familyId} ---------------------------------------------
    match /families/{familyId} {

      allow get: if canReadOf(resource.data);
      allow list: if false;

      // Create your own family only: you are the owner and the sole admin,
      // and you start with no paired devices. Anonymous (TV) accounts can't
      // create families.
      allow create: if isParentAccount()
        && request.resource.data.keys().hasOnly(['ownerUid', 'roles', 'devices'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.roles[request.auth.uid] == 'admin'
        && request.resource.data.roles.keys().hasOnly([request.auth.uid])
        && request.resource.data.get('devices', []).size() == 0;

      // Admins manage member roles. Guardrails:
      //  - only `roles` and `devices` may change (no stray fields, e.g. the
      //    retired fcmTokens),
      //  - every role is 'admin' or 'user',
      //  - ownerUid is immutable (the main admin can't be swapped out),
      //  - the owner always stays an admin (can't be demoted/removed),
      //  - the paired-device list may only be changed by the owner, and only
      //    shrink (unpair) — pairing is done server-side by claimTvPairing.
      // New members are added server-side (Cloud Functions), never by a
      // client writing themselves into roles — that was the takeover hole.
      allow update: if isAdminOf(resource.data)
        && touchesOnly(['roles', 'devices'])
        && request.resource.data.roles.values().hasOnly(['admin', 'user'])
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.roles[resource.data.ownerUid] == 'admin'
        && (
          request.resource.data.get('devices', []) == resource.data.get('devices', [])
          || (isOwnerOf(resource.data)
              && request.resource.data.get('devices', []).hasOnly(resource.data.get('devices', [])))
        );

      // Only the main admin (owner) may delete the family.
      allow delete: if isOwnerOf(resource.data);

      // ---- Subcollections -------------------------------------------------

      // Usage is written by the TV (and admins, e.g. daily reset); read by all.
      match /usage/{date} {
        allow read: if canReadOf(familyDoc(familyId));
        allow create, update: if (isDeviceOf(familyDoc(familyId)) || isAdminOf(familyDoc(familyId)))
          && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && touchesOnly(['perAppMillis', 'updatedAt', 'expireAt'])
          && (!('perAppMillis' in request.resource.data)
              || (request.resource.data.perAppMillis is map && request.resource.data.perAppMillis.size() <= 500))
          && optTimestamp('updatedAt')
          && optTimestamp('expireAt');
        allow delete: if isDeviceOf(familyDoc(familyId)) || isAdminOf(familyDoc(familyId));
      }

      // Limits/settings are set by parents only. The TV (the device being
      // restricted) can READ them but must never write them. One match per
      // doc so each has its own schema; any other doc under /limits falls
      // through to the catch-all (no writes).
      match /limits/overall {
        allow read: if canReadOf(familyDoc(familyId));
        allow create, update: if isMemberOf(familyDoc(familyId))
          && touchesOnly(['overallDailyMinutes'])
          && optInt('overallDailyMinutes', -1, 1440);
        allow delete: if isMemberOf(familyDoc(familyId));
      }

      match /limits/perApp/apps/{pkg} {
        allow read: if canReadOf(familyDoc(familyId));
        allow create, update: if isMemberOf(familyDoc(familyId))
          && isPackageName(pkg)
          && touchesOnly(['dailyLimitMinutes'])
          && optInt('dailyLimitMinutes', -1, 1440);
        allow delete: if isMemberOf(familyDoc(familyId));
      }

      match /limits/timeFrame {
        allow read: if canReadOf(familyDoc(familyId));
        allow create, update: if isMemberOf(familyDoc(familyId))
          && touchesOnly(['enabled', 'windowsByDay'])
          && optBool('enabled')
          && (!('windowsByDay' in request.resource.data)
              || (request.resource.data.windowsByDay is map && request.resource.data.windowsByDay.size() <= 7));
        allow delete: if isMemberOf(familyDoc(familyId));
      }

      match /limits/allDay {
        allow read: if canReadOf(familyDoc(familyId));
        allow create, update: if isMemberOf(familyDoc(familyId))
          && touchesOnly(['date', 'indefinite'])
          && optNullableDate('date')
          && optBool('indefinite');
        allow delete: if isMemberOf(familyDoc(familyId));
      }

      match /limits/instantLock {
        allow read: if canReadOf(familyDoc(familyId));
        allow create, update: if isMemberOf(familyDoc(familyId))
          && touchesOnly(['locked', 'date'])
          && optBool('locked')
          && optNullableDate('date');
        allow delete: if isMemberOf(familyDoc(familyId));
      }

      // Anything else under /limits (incl. the perApp doc itself): read-only.
      match /limits/{doc=**} {
        allow read: if canReadOf(familyDoc(familyId));
      }

      // The TV publishes its launchable apps; parents read them.
      match /tvApps/{pkg} {
        allow read: if canReadOf(familyDoc(familyId));
        allow create, update: if (isDeviceOf(familyDoc(familyId)) || isMemberOf(familyDoc(familyId)))
          && isPackageName(pkg)
          && touchesOnly(['label'])
          && request.resource.data.label is string
          && request.resource.data.label.size() <= 100;
        allow delete: if isDeviceOf(familyDoc(familyId)) || isMemberOf(familyDoc(familyId));
      }

      // One-time unlock codes. Parents create and list; redemption is
      // exclusively via the redeemCode Cloud Function (admin SDK), so devices
      // have no direct read or delete access — a compromised TV token can't
      // enumerate or consume codes without going through the lockout check.
      // expiresAt is bounded (a day, generous for phone clock skew; clients
      // use 5 minutes) so a code can't be made to live forever.
      match /codes/{code} {
        allow get: if isMemberOf(familyDoc(familyId));
        allow list: if isMemberOf(familyDoc(familyId));
        allow create: if isMemberOf(familyDoc(familyId))
          && code.matches('^[0-9]{6}$')
          && request.resource.data.keys().hasOnly(['extraMinutes', 'createdAt', 'expiresAt'])
          && request.resource.data.extraMinutes is int
          && request.resource.data.extraMinutes >= 1
          && request.resource.data.extraMinutes <= 1440
          && request.resource.data.createdAt == request.time
          && request.resource.data.expiresAt is timestamp
          && request.resource.data.expiresAt <= request.time + duration.value(1, 'd');
        allow delete: if isMemberOf(familyDoc(familyId));
        allow update: if false;
      }

      // Time requests. The TV may CREATE a pending request but may NOT
      // approve it — only parents can change its status. requestedMinutes
      // is bounded server-side so a compromised TV can't ask for arbitrary
      // amounts; this matches MAX_REQUESTED_MINUTES in functions/index.ts.
      match /requests/{id} {
        allow read: if canReadOf(familyDoc(familyId));
        allow create: if (isDeviceOf(familyDoc(familyId)) || isMemberOf(familyDoc(familyId)))
          && request.resource.data.keys().hasOnly(['appPackage', 'requestedMinutes', 'status', 'createdAt', 'expireAt'])
          && isPackageName(request.resource.data.appPackage)
          && request.resource.data.status == 'pending'
          && request.resource.data.requestedMinutes is int
          && request.resource.data.requestedMinutes >= 1
          && request.resource.data.requestedMinutes <= 240
          && request.resource.data.createdAt == request.time
          && optTimestamp('expireAt');
        allow update: if isMemberOf(familyDoc(familyId))
          && touchesOnly(['status', 'respondedAt', 'approvedMinutes'])
          && request.resource.data.status in ['approved', 'denied']
          && optInt('approvedMinutes', 1, 1440)
          && optTimestamp('respondedAt');
        allow delete: if isAdminOf(familyDoc(familyId));
      }

      // Lockout configuration is parent-only. The TV may only CLEAR a
      // *timer* lock (locked = false / lockedUntil removed), and only once
      // its server-set lockedUntil has actually passed — it can never SET
      // locked = true (redeemCode does that) nor lift a parent-unlock lock.
      match /settings/lockout {
        allow read: if canReadOf(familyDoc(familyId));
        allow create: if isMemberOf(familyDoc(familyId)) && lockoutParentWrite();
        allow update: if (isMemberOf(familyDoc(familyId)) && lockoutParentWrite())
          || (isDeviceOf(familyDoc(familyId))
              && touchesOnly(['locked', 'lockedUntil'])
              && request.resource.data.locked == false
              && resource.data.get('mode', 'timer') != 'parent'
              && resource.data.get('lockedUntil', null) is timestamp
              && resource.data.lockedUntil <= request.time);
        allow delete: if isMemberOf(familyDoc(familyId));

        function lockoutParentWrite() {
          return touchesOnly(['durationMinutes', 'mode', 'locked', 'lockedUntil'])
            && optInt('durationMinutes', 1, 1440)
            && (!('mode' in request.resource.data) || request.resource.data.mode in ['timer', 'parent'])
            && optBool('locked')
            && optTimestamp('lockedUntil');
        }
      }

      // The family-wide language the TV renders in. Parents only.
      match /settings/language {
        allow read: if canReadOf(familyDoc(familyId));
        allow create, update: if isMemberOf(familyDoc(familyId))
          && touchesOnly(['code'])
          && (!('code' in request.resource.data)
              || (request.resource.data.code is string && request.resource.data.code.matches('^[a-z]{2,3}$')));
        allow delete: if isMemberOf(familyDoc(familyId));
      }

      // The family's IANA time zone ("Asia/Jerusalem"): the TV measures
      // "today" and allowed hours in it, so changing the TV's own zone can't
      // shift them. Parents only.
      match /settings/timezone {
        allow read: if canReadOf(familyDoc(familyId));
        allow create, update: if isMemberOf(familyDoc(familyId))
          && touchesOnly(['zone'])
          && request.resource.data.zone is string
          && request.resource.data.zone.matches('^[A-Za-z0-9_+/-]{1,64}$');
        allow delete: if isMemberOf(familyDoc(familyId));
      }

      // Catch-all for any subcollection without an explicit rule above.
      // Reads stay open to members/devices so new read-only features
      // don't immediately break clients; WRITE is denied by default.
      //
      // Previously this granted blanket member-write, which (because
      // Firestore takes the union of matching rules) overrode the
      // narrower deny rules on /codes (`allow update: if false`) and
      // weakened the family-doc update/delete guarantees. Every
      // legitimate doc has its own write rule above; new ones must add
      // one explicitly.
      match /{document=**} {
        allow read: if canReadOf(familyDoc(familyId));
        allow write: if false;
      }
    }

    // ---- /config/{docId} ---------------------------------------------------
    // App-wide config edited by hand in the Firebase console (e.g. the
    // developer announcement). Any signed-in user may read; no client writes.
    match /config/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // ---- /invites/{code} ---------------------------------------------------
    // Fully managed by Cloud Functions (admin SDK). Direct client access is
    // denied so codes can't be enumerated, forged, or read to harvest every
    // family's id.
    match /invites/{code} {
      allow read, write: if false;
    }

    // ---- /pairings/{code} --------------------------------------------------
    // Fully managed by Cloud Functions (createTvPairing / claimTvPairing).
    match /pairings/{code} {
      allow read, write: if false;
    }

    // ---- /rateLimits/{key} -------------------------------------------------
    // Per-uid attempt counters for the guessable callables. Server-only.
    match /rateLimits/{key} {
      allow read, write: if false;
    }

    // ---- /devices/{deviceId} ----------------------------------------------
    // deviceId is the TV's anonymous-auth uid. Binding (create) happens only
    // inside claimTvPairing; the family pointer can never be changed by a
    // client write (one TV belongs to exactly one family; a family may have
    // many TVs); only the owner may unpair (delete). Parents may rename a TV;
    // the TV itself may only stamp its lastSeen heartbeat.
    match /devices/{deviceId} {
      allow get: if signedIn()
        && (request.auth.uid == deviceId || isMemberOf(familyDoc(resource.data.familyId)));
      allow list: if false;
      allow create: if false;
      allow update: if signedIn()
        && (
          (isMemberOf(familyDoc(resource.data.familyId))
            && touchesOnly(['name'])
            && request.resource.data.name is string
            && request.resource.data.name.size() >= 1
            && request.resource.data.name.size() <= 60)
          || (request.auth.uid == deviceId
            && touchesOnly(['lastSeen'])
            && request.resource.data.lastSeen == request.time)
        );
      allow delete: if isOwnerOf(familyDoc(resource.data.familyId));
    }
  }
}
